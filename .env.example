# 应用地址
APP_URL=http://localhost:3000

# 会话密钥；模拟模式首次启动自动替换
SESSION_SECRET=replace-with-32-plus-random-chars-here

# SQLite 文件，路径相对项目根目录
DATABASE_URL=file:./dev.db

# 运行模式：mock、sandbox、live
PAYMENT_MODE=mock

# 微信登录和支付：mock 保持模拟；live 使用真实网站 OAuth 和 Native 支付
# PAYMENT_MODE=mock 强制全部模拟；可用 sandbox 保持支付宝沙箱并启用微信 live
WECHAT_MODE=mock

# 支付宝网站登录：mock 或 oauth；留空时随支付模式选择
# 沙箱支付可配 mock 登录，独立验证付款
ALIPAY_LOGIN_MODE=

# 微信开放平台网站应用 ID
WECHAT_APP_ID=

# 微信登录应用密钥
WECHAT_APP_SECRET=

# 微信支付商户号
WECHAT_PAY_MCH_ID=

# 微信支付应用 ID
WECHAT_PAY_APP_ID=

# 微信支付 API v3 密钥
WECHAT_PAY_API_V3_KEY=

# 微信商户证书序列号
WECHAT_PAY_CERT_SERIAL_NO=

# 微信商户私钥路径
WECHAT_PAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem

# 微信支付平台公钥路径
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=./certs/wechatpay_public_key.pem

# 微信支付公钥 ID（PUB_KEY_ID_ 开头），或对应平台证书的序列号
WECHAT_PAY_PLATFORM_KEY_ID=

# 微信支付异步通知地址
WECHAT_PAY_NOTIFY_URL=${APP_URL}/api/pay/wechat/notify

# 支付宝应用 ID
ALIPAY_APP_ID=

# 沙箱商家信息中的商户 PID，用于核验收款方
ALIPAY_SELLER_ID=

# 支付宝应用私钥，使用 PKCS8 格式（可带 PEM 头）
ALIPAY_PRIVATE_KEY=

# 支付宝公钥
ALIPAY_PUBLIC_KEY=

# 支付宝网关，正式模式需替换
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# 支付宝异步通知地址
ALIPAY_NOTIFY_URL=${APP_URL}/api/pay/alipay/notify

# 支付宝支付返回地址
ALIPAY_RETURN_URL=${APP_URL}/orders

# 本地诊断时输出脱敏错误说明（0 关闭，1 开启）；不会额外请求平台
ALIPAY_DIAGNOSTICS=0
